{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "promise",
    "jsdoc",
    "react"
  ],
  "env": {
    "es2024": true,
    "browser": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-var": "error",
    "prefer-const": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-return": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "src/search/**/*.ts",
        "src/ui/**/*.ts",
        "src/ui/**/*.tsx",
        "test/**/*.ts"
      ],
      "rules": {
        "typescript/explicit-function-return-type": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "jsdoc/check-tag-names": "error",
        "jsdoc/require-param-description": "error",
        "jsdoc/require-returns-description": "error",
        "jsdoc/empty-tags": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-return": "error"
      }
    },
    {
      "files": [
        "test/browser/**/*.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "test/**/*.ts"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/explicit-function-return-type": "off",
        "typescript/unbound-method": "off",
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": [
        "src/ui/bar/utils/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../components/*",
                  "../hooks/*"
                ],
                "message": "The bar's model is React-free and knows nothing of what draws it: utils/ may import neither hooks/ nor components/. A contract belongs to whoever hands it out."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/bar/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../components/*"
                ],
                "message": "The bar's state layer may not reach into the view: hooks/ may not import components/. A component asks the hook for the shape it must satisfy, never the other way round."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "site/js",
    "site/dev",
    "test/.bundle",
    "src/vendor",
    "tools/*.mjs",
    "node_modules"
  ]
}
