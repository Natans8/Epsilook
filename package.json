{
  "name": "epsilook",
  "private": true,
  "type": "module",
  "description": "Search WoW spells by how they look and sound — a companion for Epsilon WoW. Static site; src/ is TypeScript bundled into site/js/ by esbuild.",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "query": "node tools/build.mjs --cli && node tools/query.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
