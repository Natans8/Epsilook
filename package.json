{
  "name": "epsilook",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Search WoW spells by how they look and sound — a companion for Epsilon WoW. Static site; src/ is TypeScript bundled into site/js/ by esbuild.",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --serve",
    "harness": "node tools/build.mjs --harness",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build.mjs --test && node --enable-source-maps --test \"test/.bundle/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "query": "node tools/build.mjs --cli && node tools/query.mjs",
    "parse": "node tools/build.mjs --cli && node tools/parse.mjs",
    "equal": "node tools/build.mjs --cli && node tools/equal.mjs",
    "simplify": "node tools/build.mjs --cli && node tools/simplify.mjs",
    "measure": "node tools/build.mjs --cli && node tools/measure.mjs",
    "battery": "node tools/build.mjs --cli && node tools/battery.mjs",
    "lint": "oxlint --type-aware",
    "surface": "node tools/build.mjs --cli && node tools/surface.mjs",
    "vacuous": "node tools/build.mjs --cli && node tools/vacuous.mjs",
    "translate": "node tools/build.mjs --cli && node tools/translate.mjs",
    "schema": "node tools/build.mjs --cli && node tools/schema.mjs"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "//": {
    "floors": "A version range only where the code needs one, its reason here; package-lock.json pins what actually runs, and npm update moves every pin at once.",
    "@types/node": "^26: the Node that devEngines runs, 26, and no other",
    "typescript": ">=5.8: tsconfig's erasableSyntaxOnly"
  },
  "devDependencies": {
    "@playwright/test": "*",
    "@types/node": "^26",
    "@types/react": "*",
    "@types/react-dom": "*",
    "esbuild": "*",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": ">=5.8",
    "varcon": "*"
  },
  "dependencies": {
    "i18next": "*",
    "i18next-browser-languagedetector": "*",
    "react": "*",
    "react-dom": "*",
    "react-i18next": "*",
    "regex-colorizer": "*"
  },
  "allowScripts": {
    "esbuild": true
  }
}
