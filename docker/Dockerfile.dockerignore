# Named for docker/Dockerfile, which is how BuildKit finds an ignore file
# that does not sit at the context root. An allowlist, not a blocklist: the build context is ~48 MB of data packs
# already, and everything else in this tree (node_modules, .git with its LFS
# objects, .cache, the exploration database) is bigger than the site.
# Listing what goes IN also means a new top-level directory cannot silently
# start being uploaded to the daemon on every build.
*

!site/
!src/
!docker/
!package.json
!package-lock.json
!tsconfig.json
!tools/build.mjs
!tools/verify_site.sh

# The image asserts org.opencontainers.image.licenses, so the text has to be in
# the context for the runtime stage to convey it. An allowlist means a licence
# file is invisible to the build until it is named here.
!LICENSE
!NOTICE

# site/js is gitignored BUILD OUTPUT. Excluding it after re-including site/ is
# what guarantees the image's bundle comes from the Dockerfile's own esbuild
# run and never from whatever a local `npm run dev` last left on disk.
site/js/

# nothing under site/ needs these, and a stray one would end up served
**/.DS_Store
**/Thumbs.db
