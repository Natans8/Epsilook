{
  // The command-line UI is the same engine on a different RUNTIME, so it needs
  // its own target: Node globals instead of the DOM. Everything else is
  // inherited, which is the point - tools/query.ts imports src/ directly and
  // must be held to exactly the same strictness as the code it calls.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "tools/query.ts",
    "tools/measure.ts",
    "tools/surface.ts",
    "tools/parse.ts",
    "tools/equal.ts",
    // The test suite is the same engine on the same runtime — Node, no DOM —
    // so it belongs to this target rather than to a third one. A directory
    // rather than a file list: tests are added constantly, and a test that
    // typechecks only by accident is worth less than no test.
    "test"
  ]
}
