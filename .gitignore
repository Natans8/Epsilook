# everything generated: downloaded game tables, the distilled TrinityCore
# dumps, the exploration database, the freshness answers. Kept out of the
# source tree so no tool that walks it has to be told to skip them.
.cache/

# the bundle esbuild emits from src/ (tools/build.mjs); pages.yml builds it
# fresh for every deploy, so the served JS is never committed
site/js/

# the CLI bundles esbuild emits from tools/*.ts (node tools/build.mjs --cli)
tools/query.mjs
tools/measure.mjs
tools/parse.mjs
tools/equal.mjs
tools/surface.mjs
tools/battery.mjs
tools/simplify.mjs

# the test bundles esbuild emits from test/*.test.ts (npm test builds them)
test/.bundle/

node_modules/

# the Python environment uv builds from pyproject.toml + uv.lock
.venv/

# IDE
.idea/
.vscode/

# local tooling
.claude/
__pycache__/
.mypy_cache/
