# downloaded source data (re-fetched by build/build_data.py)
build/cache/

# the bundle esbuild emits from src/ (tools/build.mjs); pages.yml builds it
# fresh for every deploy, so the served JS is never committed
site/js/

node_modules/

# IDE
.idea/
.vscode/

# local tooling: machine-specific settings, dev-server ports, worktrees. The
# wildcard rather than a bare `.claude/` is what lets skills/ be re-included --
# git cannot re-include a file whose parent DIRECTORY is excluded. A skill is a
# protocol this repo maintains, not local state, so it is tracked.
.claude/*
!.claude/skills/
__pycache__/
.mypy_cache/
