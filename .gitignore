# downloaded source data (re-fetched by build/build_data.py)
build/cache/

# the bundle esbuild emits from src/ (tools/build.mjs); pages.yml builds it
# fresh for every deploy, so the served JS is never committed
site/js/

# the CLI bundles esbuild emits from tools/*.ts (node tools/build.mjs --cli)
tools/query.mjs
tools/measure.mjs

# the test bundles esbuild emits from test/*.test.ts (npm test builds them)
test/.bundle/

node_modules/

# IDE
.idea/
.vscode/

# local tooling
.claude/
__pycache__/
.mypy_cache/
