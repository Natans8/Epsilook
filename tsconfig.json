{
  // Type checking only — esbuild does the emitting (tools/build.mjs).
  // Check from the repo root with: npx tsc  (tools/check.py runs it too).
  "compilerOptions": {
    // the syntax esbuild emits for the browser bundle; the library is the
    // newest year whose features are all Baseline widely available
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    // a bundler resolves and rewrites every import, so tsc is told to leave
    // them as written and resolve the way the bundler does
    "module": "preserve",
    "noEmit": true,
    "strict": true,
    // the presentation layer (src/ui) is React written as .tsx; the automatic
    // runtime, so components never import React for the JSX alone
    "jsx": "react-jsx",
    // esbuild compiles one file at a time, so every file must be checkable
    // alone, and type-only imports must say so (`import type`)
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // only syntax a type stripper can erase: no enum, namespace or parameter
    // property, which is docs/CODE_STYLE.md's literal-union rule as a compiler
    // error rather than a sentence
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // the string registry imports its locale catalogs (src/locales/) as JSON;
    // esbuild bundles them natively, this flag lets tsc type them
    "resolveJsonModule": true,
    // vendored libs in src/vendor are plain JS with hand-written .d.ts
    // beside them; tsc reads the declarations, esbuild bundles the .js
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
