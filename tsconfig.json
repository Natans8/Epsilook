{
  // Type checking only — esbuild does the emitting (tools/build.mjs).
  // Check from the repo root with: npx tsc  (tools/check.py runs it too).
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    // esbuild compiles one file at a time, so every file must be checkable
    // alone, and type-only imports must say so (`import type`)
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    // the string registry imports its locale catalogs (src/locales/) as JSON;
    // esbuild bundles them natively, this flag lets tsc type them
    "resolveJsonModule": true,
    // vendored libs in src/vendor are plain JS with hand-written .d.ts
    // beside them; tsc reads the declarations, esbuild bundles the .js
    "allowJs": false,
    // @types/node exists for tools/query.ts (see tsconfig.tools.json). Without
    // this, tsc auto-includes it EVERYWHERE and `process.env` in an app module
    // would typecheck - src/ ships to a browser and has no Node in it.
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
